# Local game setup and generated state
/san_andreas/installer/
/san_andreas/runtime/

# Python environments, caches, and test output
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
/build/
/dist/
*.egg-info/

# Local credentials; keep example configurations
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Native build intermediates
/san_andreas/native/*.def
/san_andreas/native/*.o
/san_andreas/native/*.obj
/san_andreas/native/*.pdb
/san_andreas/native/*.ilk
/san_andreas/native/*.exp
/san_andreas/native/*.lib
!/san_andreas/native/save_bridge.dll
!/san_andreas/native/save_request.exe

# Logs, temporary files, and editor/OS clutter
*.log
*.tmp
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
