# Keep portable installer metadata; transfer binary payloads in the suite ZIP.
/games/*/installer/*
!/games/*/installer/manifest.json
!/games/*/installer/first-person.json
!/games/*/installer/graphics.json
!/games/*/installer/background.json
!/games/*/installer/downloads.lock.json

# Paths, checkpoints and recovery records belong to the destination computer.
/games/san_andreas/docs/SOURCES.txt
/core/runtime/
/runtime/
/games/*/runtime/
.gtw-suite/
.gtw-classic-setup/
.sa-first-person-setup/

# Python environments, caches, and test output
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
# Build sources are versioned; generated staging directories are not.
/build/staging/
/build/suite-*/
/build/setup-*/
/dist/
*.egg-info/

# Local credentials; keep example configurations
/parameters.json
/oauth_tokens.json
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Native build intermediates
/core/native/*.def
/core/native/*.o
/core/native/*.obj
/core/native/*.pdb
/core/native/*.ilk
/core/native/*.exp
/core/native/*.lib
!/core/native/save_bridge.dll
!/core/native/save_request.exe

# Logs, temporary files, and editor/OS clutter
*.log
*.tmp
*.swp
*.swo
*.dmp
*.mdmp
.vs/
*~
.DS_Store
Thumbs.db
Desktop.ini
SOURCES.txt
build/native/SOURCES.md
