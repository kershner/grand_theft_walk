# Local game setup and generated state
/games/san_andreas/installer/
/games/vice_city/installer/
/games/gta_iii/installer/
/games/san_andreas/docs/SOURCES.txt
/core/runtime/
/runtime/
/games/san_andreas/runtime/
/games/vice_city/runtime/
/games/gta_iii/runtime/

# Python environments, caches, and test output
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
# Build sources are versioned; generated staging directories are not.
/build/staging/
/build/suite-*/
/build/setup-*/
/dist/
*.egg-info/

# Local credentials; keep example configurations
/parameters.json
/oauth_tokens.json
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Native build intermediates
/core/native/*.def
/core/native/*.o
/core/native/*.obj
/core/native/*.pdb
/core/native/*.ilk
/core/native/*.exp
/core/native/*.lib
!/core/native/save_bridge.dll
!/core/native/save_request.exe

# Logs, temporary files, and editor/OS clutter
*.log
*.tmp
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
SOURCES.txt
